xableWarningCount":0,"usedDeprecatedRules":"67"},{"filePath":"68","messages":"69","suppressedMessages":"70","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"31"},"/Users/admin/All Project/react-project/Portfolio/src/index.tsx",[],[],["71","72","73","74","75","76"],"/Users/admin/All Project/react-project/Portfolio/src/reportWebVitals.ts",[],[],"/Users/admin/All Project/react-project/Portfolio/src/App.tsx",[],[],"/Users/admin/All Project/react-project/Portfolio/src/pages/Home.page.tsx",[],[],"/Users/admin/All Project/react-project/Portfolio/src/components/shared/header/Header.tsx",[],[],"/Users/admin/All Project/react-project/Portfolio/src/components/index.ts",[],[],["77","78","79","80","81","82"],"/Users/admin/All Project/react-project/Portfolio/src/components/shared/Footer/Footer.tsx",[],[],"/Users/admin/All Project/react-project/Portfolio/src/layouts/index.ts",[],[],"/Users/admin/All Project/react-project/Portfolio/src/layouts/MainLayout/MainLayout.tsx",[],[],"/Users/admin/All Project/react-project/Portfolio/src/components/Hero.tsx",[],[],"/Users/admin/All Project/react-project/Portfolio/src/components/ContactHero.tsx",["83","84","85","86","87","88"],[],"import { ArrowRight } from \"lucide-react\";\n\nexport default function ContactHero() {\n  return (\n    <section className=\"bg-[#0A0A0A] text-white min-h-screen\">\n      <div className=\"max-w-[1700px] mx-auto px-6 lg:px-10 py-10\">\n        {/* Top Title */}\n        <div className=\"mb-10\">\n          <p className=\"uppercase tracking-[6px] text-sm text-neutral-400\">\n            Contact\n          </p>\n        </div>\n\n        <div className=\"grid lg:grid-cols-2 gap-12 items-start\">\n          {/* LEFT SIDE */}\n          <div>\n            {/* Image */}\n            <div className=\"relative overflow-hidden rounded-[32px] h-[650px]\">\n              <img\n                src=\"/images/contact-bg.jpg\"\n                alt=\"Contact\"\n                className=\"w-full h-full object-cover\"\n              />\n\n              {/* Dark Overlay */}\n              <div className=\"absolute inset-0 bg-black/35\" />\n\n              {/* Content */}\n              <div className=\"absolute bottom-12 left-10 right-10\">\n                <h1 className=\"text-6xl md:text-7xl font-serif leading-none\">\n                  Let's\n                  <br />\n                  Collaborate\n                </h1>\n\n                <p className=\"mt-6 text-neutral-300 max-w-md leading-8\">\n                  Have a project in mind or looking for a UX/UI Designer? I'd\n                  love to hear about your ideas and help transform them into\n                  meaningful digital experiences.\n                </p>\n              </div>\n            </div>\n          </div>\n\n          {/* RIGHT SIDE */}\n\n          <div className=\"bg-[#151515] rounded-[30px] p-10 border border-white/10\">\n            <h2 className=\"text-3xl font-semibold mb-2\">\n              Tell me about your project\n            </h2>\n\n            <p className=\"text-neutral-400 mb-10\">\n              Fill in the details below and I'll get back to you.\n            </p>\n\n            <form className=\"space-y-8\">\n              {/* Name */}\n\n              <div>\n                <label className=\"block mb-3 text-neutral-400\">Name</label>\n\n                <input\n                  type=\"text\"\n                  placeholder=\"Your name\"\n                  className=\"w-full bg-transparent border-b border-white/20 py-3 outline-none focus:border-white transition\"\n                />\n              </div>\n\n              {/* Email */}\n\n              <label htmlFor=\"email\" className=\"block mb-3 text-neutral-400\">\n                Email\n              </label>\n\n              <input id=\"email\" type=\"email\" placeholder=\"hello@email.com\" />\n\n              {/* Company */}\n\n              <div>\n                <label\n                  htmlFor=\"company\"\n                  className=\"block mb-3 text-neutral-400\">\n                  Company\n                </label>\n\n                <input\n                  type=\"text\"\n                  placeholder=\"Company name\"\n                  className=\"w-full bg-transparent border-b border-white/20 py-3 outline-none focus:border-white transition\"\n                />\n              </div>\n\n              {/* Budget */}\n\n              <div>\n                <label htmlFor=\"email\" className=\"block mb-3 text-neutral-400\">\n                  Budget\n                </label>\n\n                <select className=\"w-full bg-transparent border-b border-white/20 py-3 outline-none\">\n                  <option className=\"bg-black\">Select Budget</option>\n                  <option className=\"bg-black\">₹20k - ₹50k</option>\n                  <option className=\"bg-black\">₹50k - ₹1L</option>\n                  <option className=\"bg-black\">₹1L+</option>\n                </select>\n              </div>\n\n              {/* Message */}\n\n              <div>\n                <label className=\"block mb-3 text-neutral-400\">Message</label>\n\n                <textarea\n                  rows={5}\n                  placeholder=\"Tell me about your project...\"\n                  className=\"w-full bg-transparent border-b border-white/20 py-3 outline-none resize-none focus:border-white\"\n                />\n              </div>\n\n              {/* Button */}\n\n              <button\n                className=\"\n                mt-4\n                flex\n                items-center\n                gap-5\n                border\n                border-white/20\n                rounded-full\n                px-5\n                py-4\n                hover:border-white\n                transition\n                \">\n                <div className=\"w-12 h-12 rounded-full bg-white flex items-center justify-center\">\n                  <ArrowRight className=\"text-black\" size={20} />\n                </div>\n\n                <span className=\"text-lg\">Send Message</span>\n              </button>\n            </form>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n","/Users/admin/All Project/react-project/Portfolio/src/pages/Work.Project.tsx",[],[],["89","90","91","92","93","94"],"/Users/admin/All Project/react-project/Portfolio/src/components/shared/CustomCursor.tsx",[],[],{"ruleId":"95","replacedBy":"96"},{"ruleId":"97","replacedBy":"98"},{"ruleId":"99","replacedBy":"100"},{"ruleId":"101","replacedBy":"102"},{"ruleId":"103","replacedBy":"104"},{"ruleId":"105","replacedBy":"106"},{"ruleId":"95","replacedBy":"107"},{"ruleId":"97","replacedBy":"108"},{"ruleId":"99","replacedBy":"109"},{"ruleId":"101","replacedBy":"110"},{"ruleId":"103","replacedBy":"111"},{"ruleId":"105","replacedBy":"112"},{"ruleId":"113","severity":2,"message":"114","line":60,"column":17,"nodeType":"115","endLine":60,"endColumn":64},{"ruleId":"113","severity":2,"message":"114","line":71,"column":15,"nodeType":"115","endLine":71,"endColumn":78},{"ruleId":"113","severity":2,"message":"114","line":80,"column":17,"nodeType":"115","endLine":82,"endColumn":59},{"ruleId":"113","severity":2,"message":"114","line":96,"column":17,"nodeType":"115","endLine":96,"endColumn":80},{"ruleId":"113","severity":2,"message":"114","line":111,"column":17,"nodeType":"115","endLine":111,"endColumn":64},{"ruleId":"116","severity":2,"message":"117","line":122,"column":15,"nodeType":"118","messageId":"119","endLine":141,"endColumn":24},{"ruleId":"95","replacedBy":"120"},{"ruleId":"97","replacedBy":"121"},{"ruleId":"99","replacedBy":"122"},{"ruleId":"101","replacedBy":"123"},{"ruleId":"103","replacedBy":"124"},{"ruleId":"105","replacedBy":"125"},"lines-around-directive",["126"],"no-new-object",["127"],"global-require",[],"no-buffer-constructor",[],"no-new-require",[],"no-path-concat",[],["126"],["127"],[],[],[],[],"js